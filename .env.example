# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Local example:  postgresql://postgres:postgres@localhost:5432/lex_indiana?schema=public
# Managed example (Neon, RDS, Supabase, etc.) — append sslmode=require if needed.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lex_indiana?schema=public"

# Automated tests use a separate schema on the same database by default.
# Set TEST_DATABASE_URL to use a dedicated CI database instead.
# TEST_DATABASE_URL=""
# TEST_DATABASE_SCHEMA="lex_indiana_test"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
# Used to sign the short-lived two-factor challenge cookie.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Public origin of the app (no trailing slash). Required in production; also drives
# secure-cookie inference and the absolute intake/invitation links.
APP_URL="http://localhost:3000"

# Registration policy: open, bootstrap, or closed.
# bootstrap allows only the first firm, then closes automatically.
REGISTRATION_MODE="bootstrap"

# Set to "true" when served over HTTPS (production). Cookies are always httpOnly
# and SameSite=Lax; this flag adds the Secure attribute.
SESSION_COOKIE_SECURE="false"

# Label shown in authenticator apps when enrolling 2FA.
TWO_FACTOR_ISSUER="Lex Indiana"

# ---------------------------------------------------------------------------
# Document storage
# ---------------------------------------------------------------------------
# "local" = filesystem rooted at STORAGE_ROOT
# "s3"    = any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Backblaze B2)
STORAGE_DRIVER="local"
STORAGE_ROOT="./storage"
MAX_UPLOAD_MB="25"

# Only required when STORAGE_DRIVER="s3"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# AWS S3 uses virtual-hosted style. Set to "true" for MinIO and Cloudflare R2.
S3_FORCE_PATH_STYLE="false"
# Server-side encryption for S3 uploads. Set to "none" for R2/MinIO if the
# provider rejects the AES256 header.
S3_SSE="AES256"
