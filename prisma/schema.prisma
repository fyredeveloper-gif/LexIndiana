// Lex Indiana — practice management schema.
//
// TENANT ISOLATION CONTRACT
// The Firm is the tenant. Every firm-owned table carries a required `firmId`
// and all reads/writes go through src/lib/data.ts using the firm id from the
// caller's membership. `userId` on a record is attribution (who created or
// performed the work), never an access boundary.
//
// Staff authorization is role-based: OWNER, ATTORNEY, PARALEGAL, CLM,
// CONSULTANT. Capability checks live in src/lib/permissions.ts and are applied
// in both server pages and API routes. Consultants additionally require an
// explicit MatterAccess row for each matter they may see.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ContactType {
  CLIENT
  OPPOSING_PARTY
  OPPOSING_COUNSEL
  WITNESS
}

enum MatterStatus {
  INTAKE
  ACTIVE
  PENDING
  CLOSED
}

enum ServiceMethod {
  PERSONAL
  E_SERVICE
  MAIL
}

enum DocumentKind {
  UPLOAD
  GENERATED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

enum ConflictStatus {
  CLEAR
  REVIEW
  SKIPPED
}

enum IntakeStatus {
  NEW
  CONTACTED
  CONVERTED
  DECLINED
}

enum StaffRole {
  OWNER
  ATTORNEY
  PARALEGAL
  CLM
  CONSULTANT
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CalendarEventType {
  HEARING
  MEETING
  DEPOSITION
  DEADLINE
  OTHER
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  passwordHash          String
  name                  String
  indianaAttorneyNumber String?
  defaultHourlyRate     Decimal  @default(0)
  twoFactorSecret       String?
  twoFactorEnabled      Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sessions            Session[]
  memberships         Membership[]
  invitationsSent     Invitation[]       @relation("InvitationsSent")
  invitationsAccepted Invitation[]       @relation("InvitationsAccepted")
  auditLogs           AuditLog[]
  contacts            Contact[]
  matters             Matter[]
  matterContacts      MatterContact[]
  matterAccess        MatterAccess[]     @relation("MatterAccessUser")
  matterAccessGranted MatterAccess[]     @relation("MatterAccessGrantedBy")
  timeEntries         TimeEntry[]
  invoices            Invoice[]
  deadlines           Deadline[]
  templates           DocumentTemplate[]
  documents           MatterDocument[]
  intakeSubmissions   IntakeSubmission[]
  intakeAssignments   IntakeSubmission[] @relation("IntakeAssignments")
  tasksAssigned       Task[]            @relation("TaskAssignee")
  tasksCreated        Task[]            @relation("TaskCreator")
  calendarEvents      CalendarEvent[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the opaque cookie token. The raw token is never stored.
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Firm {
  id      String  @id @default(cuid())
  name    String
  address String?
  phone   String?
  email   String?

  // Invoice numbers are sequential per firm; allocate with a transaction.
  invoiceSeq Int @default(0)

  intakeEnabled  Boolean @default(false)
  // Secret, unguessable token used in the public intake URL. Rotatable.
  intakeToken    String? @unique
  intakeHeadline String?
  intakeIntro    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       Membership[]
  invitations       Invitation[]
  contacts          Contact[]
  matters           Matter[]
  matterContacts    MatterContact[]
  timeEntries       TimeEntry[]
  invoices          Invoice[]
  deadlines         Deadline[]
  templates         DocumentTemplate[]
  documents         MatterDocument[]
  intakeSubmissions IntakeSubmission[]
  auditLogs         AuditLog[]
  tasks             Task[]
  calendarEvents    CalendarEvent[]
}

/// A user belongs to exactly one firm in this version (userId is unique).
model Membership {
  id        String    @id @default(cuid())
  firmId    String
  firm      Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      StaffRole
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([firmId, role])
}

/// Single-use, expiring staff invitation. Only the token hash is stored.
model Invitation {
  id           String    @id @default(cuid())
  firmId       String
  firm         Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  email        String
  role         StaffRole
  title        String?
  tokenHash    String    @unique
  invitedById  String
  invitedBy    User      @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?     @relation("InvitationsAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([firmId, email])
  @@index([expiresAt])
}

/// Explicit consultant access to a single matter. Absence means no access.
model MatterAccess {
  matterId    String
  matter      Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("MatterAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedById String?
  grantedBy   User?    @relation("MatterAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@id([matterId, userId])
  @@index([userId])
}

/// Security- and ethics-relevant events. Never edited or deleted by the app.
model AuditLog {
  id         String   @id @default(cuid())
  firmId     String
  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([firmId, createdAt])
  @@index([firmId, action])
}

model Contact {
  id           String      @id @default(cuid())
  firmId       String
  firm         Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  type         ContactType
  name         String
  // JSON-encoded string[]: SQLite has no primitive list type (see src/lib/aliases.ts).
  aliases      String      @default("[]")
  email        String?
  phone        String?
  organization String?
  address      String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  clientOfMatters   Matter[]           @relation("MatterClient")
  matterLinks       MatterContact[]
  intakeSubmissions IntakeSubmission[]

  @@index([firmId, type])
  @@index([firmId, name])
}

model Matter {
  id           String       @id @default(cuid())
  firmId       String
  firm         Firm         @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientId     String
  client       Contact      @relation("MatterClient", fields: [clientId], references: [id], onDelete: Restrict)
  title        String
  causeNumber  String?
  county       String
  courtName    String?
  practiceArea String
  status       MatterStatus @default(INTAKE)
  notes        String?
  openedAt     DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  parties           MatterContact[]
  access            MatterAccess[]
  timeEntries       TimeEntry[]
  invoices          Invoice[]
  deadlines         Deadline[]
  documents         MatterDocument[]
  documentTemplates DocumentTemplate[]
  intakeSubmissions IntakeSubmission[]
  tasks             Task[]
  calendarEvents    CalendarEvent[]

  @@index([firmId, status])
  @@index([firmId, openedAt])
  @@index([firmId, clientId])
}

// Additional parties (opposing party, opposing counsel, witnesses) attached to a matter.
model MatterContact {
  id        String      @id @default(cuid())
  firmId    String
  firm      Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  matterId  String
  matter    Matter      @relation(fields: [matterId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      ContactType
  createdAt DateTime    @default(now())

  @@unique([matterId, contactId, role])
  @@index([firmId])
}

model TimeEntry {
  id              String    @id @default(cuid())
  firmId          String
  firm            Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  matterId        String
  matter          Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  description     String
  startedAt       DateTime?
  endedAt         DateTime?
  durationMinutes Int       @default(0)
  hourlyRate      Decimal  
  billable        Boolean   @default(true)
  invoiceId       String?
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([firmId, matterId])
  @@index([firmId, invoiceId])
  @@index([firmId, startedAt])
  @@index([firmId, userId])
}

model Invoice {
  id        String        @id @default(cuid())
  firmId    String
  firm      Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  matterId  String
  matter    Matter        @relation(fields: [matterId], references: [id], onDelete: Restrict)
  number    String
  status    InvoiceStatus @default(DRAFT)
  issueDate DateTime     
  dueDate   DateTime?    
  notes     String?
  subtotal  Decimal      
  total     Decimal      
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  items       InvoiceItem[]
  timeEntries TimeEntry[]

  @@unique([firmId, number])
  @@index([firmId, matterId])
}

// Immutable snapshot of billable work at the moment the invoice was generated.
model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  timeEntryId String?
  description String
  workDate    DateTime
  hours       Decimal 
  rate        Decimal 
  amount      Decimal 

  @@index([invoiceId])
}

model Deadline {
  id            String        @id @default(cuid())
  firmId        String
  firm          Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  matterId      String?
  matter        Matter?       @relation(fields: [matterId], references: [id], onDelete: Cascade)
  title         String
  ruleKey       String?
  ruleCitation  String?
  triggerEvent  String
  triggerDate   DateTime     
  serviceMethod ServiceMethod @default(E_SERVICE)
  daysAdded     Int
  dueDate       DateTime     
  completed     Boolean       @default(false)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([firmId, dueDate])
  @@index([firmId, matterId])
}

/// A firm-scoped to-do item. Assignees are firm members; matterId is optional
/// so a task can be firm-wide. Completion is a reversible flag, not a delete.
model Task {
  id          String       @id @default(cuid())
  firmId      String
  firm        Firm         @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId    String?
  matter      Matter?      @relation(fields: [matterId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?   
  priority    TaskPriority @default(MEDIUM)
  completed   Boolean      @default(false)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([firmId, completed, dueDate])
  @@index([firmId, matterId])
  @@index([firmId, assigneeId])
}

/// A firm-scoped calendar item. Times are stored as timestamps and rendered
/// in the firm's Indiana time zone.
model CalendarEvent {
  id          String            @id @default(cuid())
  firmId      String
  firm        Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId    String?
  matter      Matter?           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        CalendarEventType @default(MEETING)
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean           @default(false)
  location    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([firmId, startsAt])
  @@index([firmId, matterId])
}

model DocumentTemplate {
  id              String   @id @default(cuid())
  firmId          String
  firm            Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  fileName        String
  storageKey      String
  size            Int
  defaultMatterId String?
  defaultMatter   Matter?  @relation(fields: [defaultMatterId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documents MatterDocument[]

  @@index([firmId])
}

/// A public intake submission. The firm's authorized staff can read it; the
/// public API only ever returns a neutral confirmation with a reference code.
model IntakeSubmission {
  id                String         @id @default(cuid())
  firmId            String
  firm              Firm           @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedToId      String?
  assignedTo        User?          @relation("IntakeAssignments", fields: [assignedToId], references: [id], onDelete: SetNull)
  reference         String
  name              String
  email             String
  phone             String
  organization      String?
  county            String
  practiceArea      String
  summary           String
  opposingParties   String?
  referralSource    String?
  conflictStatus    ConflictStatus @default(SKIPPED)
  // Snapshot of the screening run: terms, scanned counts, matching contacts.
  conflictMatches   Json?
  conflictCheckedAt DateTime?
  status            IntakeStatus   @default(NEW)
  internalNote      String?
  contactId         String?
  contact           Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  matterId          String?
  matter            Matter?        @relation(fields: [matterId], references: [id], onDelete: SetNull)
  // Salted hash only; raw IP addresses are never stored.
  ipHash            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([firmId, reference])
  @@index([firmId, createdAt])
  @@index([firmId, status])
  @@index([firmId, conflictStatus])
  @@index([firmId, assignedToId])
}

model MatterDocument {
  id         String            @id @default(cuid())
  firmId     String
  firm       Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  matterId   String
  matter     Matter            @relation(fields: [matterId], references: [id], onDelete: Cascade)
  templateId String?
  template   DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  fileName   String
  storageKey String
  mimeType   String
  size       Int
  kind       DocumentKind      @default(UPLOAD)
  createdAt  DateTime          @default(now())

  @@index([firmId, matterId])
}

// ---------------------------------------------------------------------------
// Sync (Phase 2)
//
// SyncOperation doubles as the local outbox and the server's change feed:
// every captured write appends one row; a device pushes rows it has not pushed
// yet (pushedAt IS NULL) and pulls rows created by other devices.
// Payloads are JSON text so the same code runs on SQLite and PostgreSQL.
// ---------------------------------------------------------------------------
model SyncOperation {
  id            String    @id @default(cuid())
  firmId        String
  deviceId      String
  entity        String
  entityId      String
  operation     String
  payload       String?
  baseUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
  pushedAt      DateTime?
  attempts      Int       @default(0)
  lastError     String?

  @@index([firmId, createdAt])
  @@index([firmId, deviceId, pushedAt])
  @@index([firmId, entity, entityId])
}

/// One row per (firm, device): pull cursor, last successful push, bootstrap marker.
model SyncCursor {
  id              String    @id
  firmId          String
  deviceId        String
  lastPulledAt    DateTime?
  lastPushedAt    DateTime?
  lastBootstrapAt DateTime?
  lastError       String?
  updatedAt       DateTime  @updatedAt

  @@index([firmId])
}

/// Deletion markers so a late CREATE cannot resurrect a deleted record.
model SyncTombstone {
  id        String   @id @default(cuid())
  firmId    String
  deviceId  String
  entity    String
  entityId  String
  deletedAt DateTime @default(now())

  @@unique([firmId, entity, entityId])
  @@index([firmId, deletedAt])
}

/// A losing local edit. The server version is kept; the user can review it.
model SyncConflict {
  id            String    @id @default(cuid())
  firmId        String
  deviceId      String
  entity        String
  entityId      String
  localPayload  String?
  remotePayload String?
  status        String    @default("OPEN")
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([firmId, status])
}
